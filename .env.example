# QFlow - Environment Variables
# Copy this file to .env.local and fill in the values.
# The app accepts multiple aliases for each variable (see src/lib/supabase.ts).

# ──────────────────────────────────────────────
# Supabase (required)
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable/Anon key (client-side) — any of these works:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_PUBLISHABLE_KEY=...
# SUPABASE_ANON_KEY=...

# Secret/Service-role key (server-side only) — any of these works:
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_SERVICE_KEY=...

# ──────────────────────────────────────────────
# App URL (used in password-reset emails, etc.)
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Web Push / VAPID keys (optional — enables push notifications)
# Generate with: npx web-push generate-vapid-keys
# ──────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
