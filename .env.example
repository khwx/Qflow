# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Nova nomenclatura (Supabase 2025+): URL + PUBLISHABLE_KEY / SECRET_KEY
# Antiga (ainda compatível): ANON_KEY / SERVICE_ROLE_KEY — o código aceita ambas
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# ou: NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# ou: SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vercel: adicionar as 4 vars acima em Project > Settings > Environment Variables
# Project-specific settings
PROJECT_NAME=tirasenha